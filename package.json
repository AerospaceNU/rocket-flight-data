{
  "name": "rocket-flight-data",
  "version": "0.1.0",
  "description": "Desktop app for rocket flight data exploration.",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder",
    "dist:installer": "electron-vite build && electron-builder --win nsis",
    "dist:portable": "electron-vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.rocket-flight-data.app",
    "productName": "Rocket Flight Data",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Rocket Flight Data"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "publish": null
  },
  "keywords": [
    "electron",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "typescript": "^5.8.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/mapbox": "^9.3.2",
    "@deck.gl/mesh-layers": "^9.3.2",
    "@loaders.gl/obj": "^4.4.2",
    "geomagnetism": "^0.2.0",
    "maplibre-gl": "^5.24.0",
    "plotly.js-basic-dist-min": "^3.5.1",
    "plotly.js-gl3d-dist-min": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
